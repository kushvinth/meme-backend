#  before PyInstaller builds the exe, so as to inject date/other infos.
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Pydantic / mypy caches
.mypy_cache/

# IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
Thumbs.db
desktop.ini

# Logs
*.log

